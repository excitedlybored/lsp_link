#!/usr/bin/env bash
set -euo pipefail

repository_root=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)
default_config="${repository_root}/config/default.json"

usage() {
  cat <<'EOF'
Usage:
  Production (publishes the knowledge graph):
  ./lsp-link index REPOSITORY [--background] [advanced index options]

  Diagnostic (semantic crawl only; does not publish a graph):
  ./lsp-link crawl REPOSITORY [advanced crawl options]

Use `index` for normal operation. It automatically installs missing bundled
tools, loads config/default.json, prepares the build model, crawls language
servers, enriches JVM artifacts, and publishes the graph index.

Use `crawl` only for LSP/JDT performance measurements and semantic parity
checks. It stops after writing an lsp-crawl checkpoint.

Background files are written inside the target repository:
  .gitnexus/index.log
  .gitnexus/index.pid
EOF
}

resolve_file() {
  node -e 'console.log(require("node:path").resolve(process.argv[1]))' "$1"
}

run_pipeline() {
  local action=$1
  local workspace=$2
  local config=$3
  shift 3

  cd "$repository_root"
  local kotlin_launcher="${repository_root}/.gitnexus/tools/kotlin-lsp/262.9593.0/bin/intellij-server"
  local kotlin_platform_marker="${repository_root}/.gitnexus/tools/kotlin-lsp/262.9593.0/.gitnexus-platform"
  local kotlin_expected_platform=""
  local kotlin_installed_platform=""
  local kotlin_missing=false
  case "$(uname -s)-$(uname -m)" in
    Linux-x86_64) kotlin_expected_platform="linux-x64" ;;
    Darwin-arm64) kotlin_expected_platform="macos-arm64" ;;
  esac
  if [ -f "$kotlin_platform_marker" ]; then
    kotlin_installed_platform=$(tr -d '[:space:]' < "$kotlin_platform_marker")
  fi
  if [ -n "$kotlin_expected_platform" ] && [ -z "${GITNEXUS_KOTLIN_LSP_BIN:-}" ] \
    && { [ ! -x "$kotlin_launcher" ] || [ "$kotlin_installed_platform" != "$kotlin_expected_platform" ]; }; then
    kotlin_missing=true
  fi
  local spring_tools_root="${repository_root}/.gitnexus/tools/spring-tools/5.3.0.RELEASE/extension/language-server"
  local spring_tools_server
  local spring_tools_missing=false
  spring_tools_server=$(find "$spring_tools_root" -maxdepth 1 -name '*spring-boot-language-server*.jar' -print -quit 2>/dev/null || true)
  case "${GITNEXUS_SPRING_TOOLS:-true}" in
    0|false|FALSE|off|OFF|no|NO) ;;
    *)
      if [ -z "${GITNEXUS_SPRING_TOOLS_HOME:-}" ] && [ -z "$spring_tools_server" ]; then
        spring_tools_missing=true
      fi
      ;;
  esac
  if [ ! -x "${repository_root}/node_modules/.bin/tsx" ] \
    || [ "$spring_tools_missing" = true ] \
    || [ "$kotlin_missing" = true ]; then
    echo "[pipeline:install] required tools are missing; running the offline installer"
    ./install.sh
  fi

  local artifact_worker="${repository_root}/dist/jvm-artifact-worker/gitnexus-artifact-worker.jar"
  if [ ! -f "$artifact_worker" ] \
    || find "${repository_root}/jvm_artifact_worker" "${repository_root}/scripts/build-artifact-worker.mjs" \
      -type f -newer "$artifact_worker" -print -quit | grep -q .; then
    echo "[pipeline:build-tools] building the JVM artifact worker"
    npm run artifact-worker:build
  fi

  local sootup_worker="${repository_root}/dist/sootup-worker/gitnexus-sootup-worker.jar"
  if [ ! -f "$sootup_worker" ] \
    || find "${repository_root}/sootup_worker" "${repository_root}/scripts/build-sootup-worker.mjs" \
      -type f -newer "$sootup_worker" -print -quit | grep -q .; then
    echo "[pipeline:build-tools] building the SootUp program-analysis worker"
    npm run sootup-worker:build
  fi

  local jdt_batch_extension="${repository_root}/dist/jdt-batch-extension/gitnexus-jdt-batch-extension.jar"
  if [ ! -f "$jdt_batch_extension" ] \
    || find "${repository_root}/jdt_batch_extension" "${repository_root}/scripts/build-jdt-batch-extension.mjs" \
      -type f -newer "$jdt_batch_extension" -print -quit | grep -q .; then
    echo "[pipeline:build-tools] building the JDT batch extension"
    npm run jdt-batch-extension:build
  fi

  local build_model_mode
  build_model_mode=$(node -e '
    const config = JSON.parse(require("node:fs").readFileSync(process.argv[1], "utf8"));
    const value = config?.bazel?.buildModelMode
      ?? ({ managed: "integrated", prebuilt: "prepared" })[config?.bazel?.buildMode]
      ?? "integrated";
    if (value !== "integrated" && value !== "prepared") {
      throw new Error(`Unsupported bazel.buildModelMode: ${value}`);
    }
    process.stdout.write(value);
  ' "$config")

  if [ "$build_model_mode" = "prepared" ]; then
    echo "[pipeline:prepare-build-model] resolving the reusable Bazel indexing model"
    npm run index -- prepare-build-model "$workspace" --config "$config"
  fi
  if [ "$action" = "crawl" ]; then
    echo "[pipeline:crawl] crawling semantics and writing a comparison checkpoint"
    npm run index -- crawl "$workspace" --config "$config" "$@"
  else
    echo "[pipeline:build-index] crawling semantics and publishing the knowledge graph"
    npm run index -- build-index "$workspace" --config "$config" "$@"
  fi
}

if [ "${1:-}" = "__run-background" ]; then
  workspace=$2
  config=$3
  pid_file=$4
  shift 4
  cleanup_pid() {
    if [ -f "$pid_file" ] && [ "$(tr -d '[:space:]' < "$pid_file")" = "$$" ]; then
      rm -f "$pid_file"
    fi
  }
  trap cleanup_pid EXIT
  _attempt=0
  while [ "$_attempt" -lt 100 ]; do
    if [ -f "$pid_file" ] && [ "$(tr -d '[:space:]' < "$pid_file")" = "$$" ]; then break; fi
    sleep 0.01
    _attempt=$((_attempt + 1))
  done
  if [ ! -f "$pid_file" ] || [ "$(tr -d '[:space:]' < "$pid_file")" != "$$" ]; then
    echo "Background PID ownership could not be established." >&2
    exit 1
  fi
  run_pipeline index "$workspace" "$config" "$@"
  exit 0
fi

if [ "${1:-}" != "index" ] && [ "${1:-}" != "crawl" ]; then
  usage
  if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ] || [ -z "${1:-}" ]; then exit 0; fi
  exit 2
fi
action=$1
shift

if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ]; then usage; exit 0; fi

if [ -z "${1:-}" ] || [[ "${1:-}" == --* ]]; then
  echo "A repository path is required." >&2
  usage >&2
  exit 2
fi
workspace=$(cd "$1" && pwd -P)
shift

background=false
config=$default_config
forwarded=()
has_forwarded=false
while [ "$#" -gt 0 ]; do
  case "$1" in
    --background)
      background=true
      shift
      ;;
    --config)
      if [ -z "${2:-}" ]; then echo "--config requires a path" >&2; exit 2; fi
      config=$(resolve_file "$2")
      shift 2
      ;;
    *)
      forwarded+=("$1")
      has_forwarded=true
      shift
      ;;
  esac
done

if [ ! -f "$config" ]; then
  echo "Index configuration does not exist: $config" >&2
  exit 2
fi

if [ "$action" = "crawl" ] && [ "$background" = true ]; then
  echo "--background is currently supported only by the index command." >&2
  exit 2
fi

if [ "$background" = false ]; then
  if [ "$has_forwarded" = true ]; then
    run_pipeline "$action" "$workspace" "$config" "${forwarded[@]}"
  else
    run_pipeline "$action" "$workspace" "$config"
  fi
  exit 0
fi

runtime_directory="${workspace}/.gitnexus"
log_file="${runtime_directory}/index.log"
pid_file="${runtime_directory}/index.pid"
mkdir -p "$runtime_directory"
if [ -f "$pid_file" ]; then
  existing_pid=$(tr -d '[:space:]' < "$pid_file")
  if [[ "$existing_pid" =~ ^[0-9]+$ ]] && kill -0 "$existing_pid" 2>/dev/null; then
    echo "An index job is already running for this repository (PID $existing_pid)." >&2
    exit 1
  fi
  rm -f "$pid_file"
fi

if [ "$has_forwarded" = true ]; then
  nohup "$0" __run-background "$workspace" "$config" "$pid_file" "${forwarded[@]}" \
    > "$log_file" 2>&1 < /dev/null &
else
  nohup "$0" __run-background "$workspace" "$config" "$pid_file" \
    > "$log_file" 2>&1 < /dev/null &
fi
background_pid=$!
printf '%s\n' "$background_pid" > "$pid_file"
echo "Indexing started in the background."
echo "  PID: $background_pid"
echo "  Log: $log_file"
echo "  Graph: ${workspace}/.gitnexus/lsp-lbug"
