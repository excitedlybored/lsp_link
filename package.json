{
  "name": "lsp-link",
  "version": "1.0.0",
  "description": "Polyglot LSP-native indexing engine and evidence-backed LadybugDB knowledge graph",
  "private": true,
  "type": "module",
  "workspaces": [
    "indexer",
    "lsp_server"
  ],
  "scripts": {
    "index": "tsx indexer/src/cli/build.ts",
    "lbug:read": "uv run --with-requirements analyzer/requirements.lock.txt python analyzer/lbug_client.py",
    "graph:summary": "uv run --with-requirements analyzer/requirements.lock.txt python analyzer/query_db.py",
    "mcp:analyzer": "uv run --with-requirements analyzer/requirements.lock.txt python analyzer/mcp_server.py",
    "extract": "uv run --with-requirements analyzer/requirements.lock.txt python -m analyzer.extractors.run",
    "test:extractors": "uv run --with-requirements analyzer/requirements.lock.txt python -m unittest analyzer.extractors.test_core",
    "query": "tsx lsp_server/query.ts",
    "indexer:build": "npm run build --workspace lsp-indexer",
    "indexer:test": "npm run test --workspace lsp-indexer",
    "server": "tsx lsp_server/server_launcher.ts",
    "build": "npm --workspaces run build --if-present",
    "test": "npm --workspaces run test --if-present && npm run test:extractors"
  },
  "overrides": {
    "vscode-languageserver-protocol": {
      "vscode-jsonrpc": "file:./vendor/npm/vscode-jsonrpc-9.0.1.tgz",
      "vscode-languageserver-types": "file:./vendor/npm/vscode-languageserver-types-3.18.0.tgz"
    },
    "minimatch": "file:./vendor/npm/minimatch-10.2.6.tgz",
    "brace-expansion": "file:./vendor/npm/brace-expansion-5.0.9.tgz",
    "balanced-match": "file:./vendor/npm/balanced-match-4.0.4.tgz",
    "lru-cache": "file:./vendor/npm/lru-cache-11.5.2.tgz",
    "path-scurry": "file:./vendor/npm/path-scurry-2.0.2.tgz",
    "minipass": "file:./vendor/npm/minipass-7.1.3.tgz",
    "undici-types": "file:./vendor/npm/undici-types-8.3.0.tgz",
    "esbuild": "file:./vendor/npm/esbuild-0.28.2.tgz",
    "@esbuild/darwin-arm64": "file:./vendor/npm/esbuild-darwin-arm64-0.28.2.tgz",
    "@ladybugdb/core-darwin-arm64": "file:./vendor/npm/ladybugdb-core-darwin-arm64-0.19.1.tgz",
    "@ladybugdb/core-darwin-x64": "file:./vendor/npm/ladybugdb-core-darwin-x64-0.19.1.tgz",
    "@ladybugdb/core-linux-arm64": "file:./vendor/npm/ladybugdb-core-linux-arm64-0.19.1.tgz",
    "@ladybugdb/core-linux-x64": "file:./vendor/npm/ladybugdb-core-linux-x64-0.19.1.tgz",
    "@ladybugdb/core-win32-x64": "file:./vendor/npm/ladybugdb-core-win32-x64-0.19.1.tgz",
    "fsevents": "file:./vendor/npm/fsevents-2.3.3.tgz"
  },
  "devDependencies": {
    "@types/node": "file:./vendor/npm/types-node-26.2.0.tgz",
    "tsx": "file:./vendor/npm/tsx-4.23.12.tgz",
    "typescript": "file:./vendor/npm/typescript-5.9.3.tgz"
  },
  "keywords": [
    "lsp",
    "language-server-protocol",
    "knowledge-graph",
    "polyglot",
    "banking",
    "java",
    "python",
    "cobol",
    "cpp",
    "rust",
    "typescript",
    "csharp",
    "jdtls",
    "pyright",
    "clangd",
    "rust-analyzer"
  ],
  "author": "Antigravity Engineering",
  "license": "MIT"
}
