{
  "name": "lsp-link",
  "version": "1.0.0",
  "description": "Polyglot Language Server Protocol (LSP) Engine & Compiler-Verified Knowledge Graph for Enterprise Banking and Modern IDEs",
  "private": true,
  "type": "module",
  "workspaces": [
    "indexer",
    "lsp_server"
  ],
  "scripts": {
    "index": "tsx indexer/src/cli/build.ts",
    "lbug:read": "uv run python analyzer/lbug_client.py",
    "graph:summary": "uv run python analyzer/query_db.py",
    "mcp:analyzer": "uv run python analyzer/mcp_server.py",
    "rules:analyze": "uv run python -m analyzer.rules.run",
    "query": "tsx lsp_server/query.ts",
    "indexer:build": "npm run build --workspace lsp-indexer",
    "indexer:test": "npm run test --workspace lsp-indexer",
    "server": "tsx lsp_server/server_launcher.ts",
    "build": "npm --workspaces run build --if-present",
    "test": "npm --workspaces run test --if-present"
  },
  "overrides": {
    "vscode-languageserver-protocol": {
      "vscode-jsonrpc": "file:./lsp_server/vendor/vscode-jsonrpc-9.0.1.tgz",
      "vscode-languageserver-types": "file:./lsp_server/vendor/vscode-languageserver-types-3.18.0.tgz"
    },
    "minimatch": "file:./lsp_server/vendor/minimatch-10.2.6.tgz",
    "brace-expansion": "file:./lsp_server/vendor/brace-expansion-5.0.9.tgz",
    "balanced-match": "file:./lsp_server/vendor/balanced-match-4.0.4.tgz",
    "lru-cache": "file:./lsp_server/vendor/lru-cache-11.5.2.tgz",
    "path-scurry": "file:./lsp_server/vendor/path-scurry-2.0.2.tgz",
    "minipass": "file:./lsp_server/vendor/minipass-7.1.3.tgz",
    "undici-types": "file:./lsp_server/vendor/undici-types-8.3.0.tgz",
    "esbuild": "file:./lsp_server/vendor/esbuild-0.28.2.tgz",
    "@esbuild/darwin-arm64": "file:./lsp_server/vendor/esbuild-darwin-arm64-0.28.2.tgz",
    "fsevents": "file:./lsp_server/vendor/fsevents-2.3.3.tgz"
  },
  "devDependencies": {
    "@types/node": "file:./lsp_server/vendor/types-node-26.2.0.tgz",
    "tsx": "file:./lsp_server/vendor/tsx-4.23.12.tgz",
    "typescript": "file:./lsp_server/vendor/typescript-5.9.3.tgz"
  },
  "keywords": [
    "lsp",
    "language-server-protocol",
    "knowledge-graph",
    "polyglot",
    "banking",
    "java",
    "python",
    "cobol",
    "cpp",
    "rust",
    "typescript",
    "csharp",
    "jdtls",
    "pyright",
    "clangd",
    "rust-analyzer"
  ],
  "author": "Antigravity Engineering",
  "license": "MIT"
}
