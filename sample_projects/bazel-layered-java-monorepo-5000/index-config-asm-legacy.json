{
  "schemaVersion": 2,
  "name": "layered-java-5000-asm-legacy-proxy",
  "bazel": {
    "buildModelMode": "prepared",
    "scope": {
      "includeTargetPatterns": ["//..."],
      "includeRuleKinds": ["java_binary", "java_library", "java_test"],
      "explicitTargets": [],
      "excludeTargetNamePatterns": [
        ".*_deploy_bannedcheck$",
        ".*-sonar$",
        ".*-sq$"
      ],
      "excludeLabels": [
        "//:coverage-summary",
        "//:dependency-report"
      ],
      "excludeTags": ["coverage", "reporting-only"]
    },
    "preparation": {
      "concurrency": 4,
      "timeoutMs": 3600000
    }
  },
  "crawl": {
    "profile": "core",
    "javaSemantics": "batch",
    "concurrency": 4,
    "jdtProcesses": 1,
    "resume": true
  },
  "artifacts": {
    "analyzer": "asm",
    "projection": "legacy",
    "externalBodies": "none",
    "concurrency": 4,
    "maxClasses": null,
    "fetchSources": true,
    "classpathManifests": []
  },
  "quality": {
    "failOnFailedBuildRoot": true
  },
  "checkpoints": {
    "directory": null
  }
}
