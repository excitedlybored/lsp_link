    srcs = glob(["src/main/java/**/*.java"]),
    resources = glob(["src/main/resources/**"]),
    deps = [
        "@maven//:org_springframework_boot_spring_boot",
        "@maven//:org_springframework_data_spring_data_mongodb",
        "@maven//:org_springframework_data_spring_data_commons",
        "@maven//:org_springframework_spring_web",
        "@maven//:org_springframework_spring_context",
        "@maven//:org_springframework_spring_beans",
        "@maven//:org_springframework_boot_spring_boot_autoconfigure",
        "@maven//:io_temporal_temporal_serviceclient",
        "@maven//:org_springframework_kafka_spring_kafka","@maven//:io_temporal_temporal_sdk", "@maven//:org_springframework_boot_spring_boot_starter_data_mongodb", "@maven//:org_springframework_boot_spring_boot_starter_web"],
