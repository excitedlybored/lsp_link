{
  "id": "temporal",
  "schemaVersion": 1,
  "version": "1.3.0",
  "description": "Temporal Java workflows identified from scalable JVM evidence with optional LSP enrichment.",
  "dataSource": "ladybugdb-only",
  "identityPolicy": "framework-semantic-identities",
  "semanticTypes": {
    "workflowContract": "io.temporal.workflow.WorkflowInterface",
    "workflowEntryPoint": "io.temporal.workflow.WorkflowMethod",
    "signalEntryPoint": "io.temporal.workflow.SignalMethod",
    "queryEntryPoint": "io.temporal.workflow.QueryMethod",
    "updateEntryPoint": "io.temporal.workflow.UpdateMethod",
    "activityContract": "io.temporal.activity.ActivityInterface",
    "workflowClient": "io.temporal.client.WorkflowClient",
    "serviceClient": "io.temporal.serviceclient.WorkflowServiceStubs"
  },
  "applicabilitySemanticTypes": [
    "workflowContract"
  ],
  "completenessRequirements": {
    "tables": [
      "LspCoverage",
      "LspAnalysisRun",
      "LspBuildRoot",
      "JvmArtifactEnrichmentRun"
    ],
    "lspCapabilities": [
      "textDocument/documentSymbol"
    ]
  },
  "assemblerModule": "analyzer.extractors.temporal.assembler",
  "requiredTables": [
    "LspDocument",
    "LspInterfaceSymbol",
    "LspClassSymbol",
    "LspMethodSymbol",
    "LspCallSite",
    "LspHover",
    "LspRelation",
    "LspLogicalInvocation",
    "DerivedCallRelation",
    "JvmClassResolution",
    "JvmClass",
    "LspJvmBinding"
  ],
  "queries": [
    {
      "id": "sdk_classes",
      "projections": ["legacy"],
      "category": "dependency",
      "description": "Temporal SDK classes present in the artifact-enrichment stage.",
      "file": "queries/sdk_classes.cypher",
      "parameters": {
        "workflowContractType": {"semanticType": "workflowContract"},
        "sdkNamespacePrefix": "io.temporal."
      }
    },
    {
      "id": "workflow_contracts",
      "category": "contract",
      "description": "Interfaces confirmed by LSP hover evidence for @WorkflowInterface or a contained @WorkflowMethod.",
      "file": "queries/workflow_contracts.cypher",
      "parameters": {
        "workflowContractType": {"semanticType": "workflowContract"},
        "workflowEntryPointType": {"semanticType": "workflowEntryPoint"}
      }
    },
    {
      "id": "jvm_workflow_contracts",
      "projections": ["legacy"],
      "category": "contract",
      "description": "Workflow interfaces confirmed directly from compiled class and method annotations.",
      "file": "queries/jvm_workflow_contracts.cypher",
      "parameters": {
        "workflowContractType": {"semanticType": "workflowContract"},
        "workflowEntryPointType": {"semanticType": "workflowEntryPoint"}
      }
    },
    {
      "id": "activity_contracts",
      "category": "contract",
      "description": "Interfaces whose nearby LSP hover resolves @ActivityInterface.",
      "file": "queries/activity_contracts.cypher",
      "parameters": {
        "activityContractType": {"semanticType": "activityContract"}
      }
    },
    {
      "id": "jvm_activity_contracts",
      "projections": ["legacy"],
      "category": "contract",
      "description": "Activity interfaces confirmed directly from compiled class annotations.",
      "file": "queries/jvm_activity_contracts.cypher",
      "parameters": {
        "activityContractType": {"semanticType": "activityContract"}
      }
    },
    {
      "id": "annotated_methods",
      "category": "entrypoint",
      "description": "Workflow, signal, query, update, and activity methods identified by resolved annotation hover.",
      "file": "queries/annotated_methods.cypher",
      "parameters": {
        "workflowEntryPointType": {"semanticType": "workflowEntryPoint"},
        "signalEntryPointType": {"semanticType": "signalEntryPoint"},
        "queryEntryPointType": {"semanticType": "queryEntryPoint"},
        "updateEntryPointType": {"semanticType": "updateEntryPoint"},
        "activityContractType": {"semanticType": "activityContract"}
      }
    },
    {
      "id": "jvm_annotated_methods",
      "projections": ["legacy"],
      "category": "entrypoint",
      "description": "Workflow, signal, query, update, and activity methods identified from bytecode annotations.",
      "file": "queries/jvm_annotated_methods.cypher",
      "parameters": {
        "workflowEntryPointType": {"semanticType": "workflowEntryPoint"},
        "signalEntryPointType": {"semanticType": "signalEntryPoint"},
        "queryEntryPointType": {"semanticType": "queryEntryPoint"},
        "updateEntryPointType": {"semanticType": "updateEntryPoint"},
        "activityContractType": {"semanticType": "activityContract"}
      }
    },
    {
      "id": "implementations",
      "category": "implementation",
      "description": "LSP textDocument/implementation relations between classes and interfaces.",
      "file": "queries/implementations.cypher"
    },
    {
      "id": "jvm_implementations",
      "projections": ["legacy"],
      "category": "implementation",
      "description": "Compiled classes connected to workflow and activity interfaces by BYTECODE_INTERFACE.",
      "file": "queries/jvm_implementations.cypher",
      "parameters": {
        "workflowContractType": {"semanticType": "workflowContract"},
        "activityContractType": {"semanticType": "activityContract"}
      }
    },
    {
      "id": "method_implementations",
      "category": "implementation",
      "description": "LSP implementation relations between concrete and interface methods.",
      "file": "queries/method_implementations.cypher"
    },
    {
      "id": "jvm_method_implementations",
      "projections": ["legacy"],
      "category": "implementation",
      "description": "Concrete bytecode methods matched exactly to implemented interface methods.",
      "file": "queries/jvm_method_implementations.cypher",
      "parameters": {
        "workflowContractType": {"semanticType": "workflowContract"},
        "activityContractType": {"semanticType": "activityContract"}
      }
    },
    {
      "id": "resolved_calls",
      "category": "flow",
      "description": "Ranged call sites with their LSP-resolved targets and containing symbols.",
      "file": "queries/resolved_calls.cypher"
    },
    {
      "id": "jvm_resolved_calls",
      "projections": ["legacy"],
      "category": "flow",
      "description": "Resolved bytecode call sites with owning classes and methods.",
      "file": "queries/jvm_resolved_calls.cypher",
      "parameters": {
        "workflowContractType": {"semanticType": "workflowContract"}
      }
    },
    {
      "id": "temporal_sdk_calls",
      "category": "runtime",
      "description": "Calls resolved into io.temporal APIs, including stubs, starts, workers, signals, and queries.",
      "file": "queries/temporal_sdk_calls.cypher",
      "parameters": {
        "workflowClientType": {"semanticType": "workflowClient"},
        "serviceClientType": {"semanticType": "serviceClient"},
        "sdkNamespacePrefix": "io.temporal."
      }
    },
    {
      "id": "jvm_temporal_sdk_calls",
      "projections": ["legacy"],
      "category": "runtime",
      "description": "Resolved bytecode calls into canonical io.temporal APIs or annotated workflow contract methods.",
      "file": "queries/jvm_temporal_sdk_calls.cypher",
      "parameters": {
        "sdkNamespacePrefix": "io.temporal.",
        "workflowEntryPointType": {"semanticType": "workflowEntryPoint"},
        "signalEntryPointType": {"semanticType": "signalEntryPoint"},
        "queryEntryPointType": {"semanticType": "queryEntryPoint"},
        "updateEntryPointType": {"semanticType": "updateEntryPoint"}
      }
    },
    {
      "id": "compact_sdk_classes",
      "projections": ["compact"],
      "category": "dependency",
      "description": "Temporal classes retained by the compact JVM projection.",
      "file": "queries/compact_sdk_classes.cypher",
      "parameters": {"sdkNamespacePrefix": "io.temporal."}
    },
    {
      "id": "compact_workflow_contracts",
      "projections": ["compact"],
      "category": "contract",
      "description": "Workflow contracts from compact JVM annotation evidence.",
      "file": "queries/compact_contracts.cypher",
      "parameters": {
        "contractKind": "workflow",
        "contractType": {"semanticType": "workflowContract"},
        "methodType": {"semanticType": "workflowEntryPoint"}
      }
    },
    {
      "id": "compact_activity_contracts",
      "projections": ["compact"],
      "category": "contract",
      "description": "Activity contracts from compact JVM annotation evidence.",
      "file": "queries/compact_contracts.cypher",
      "parameters": {
        "contractKind": "activity",
        "contractType": {"semanticType": "activityContract"},
        "methodType": {"semanticType": "workflowEntryPoint"}
      }
    },
    {
      "id": "compact_annotated_methods",
      "projections": ["compact"],
      "category": "entrypoint",
      "description": "Temporal entry points from compact JVM annotation evidence.",
      "file": "queries/compact_annotated_methods.cypher",
      "parameters": {
        "workflowEntryPointType": {"semanticType": "workflowEntryPoint"},
        "signalEntryPointType": {"semanticType": "signalEntryPoint"},
        "queryEntryPointType": {"semanticType": "queryEntryPoint"},
        "updateEntryPointType": {"semanticType": "updateEntryPoint"},
        "activityContractType": {"semanticType": "activityContract"}
      }
    },
    {
      "id": "compact_implementations",
      "projections": ["compact"],
      "category": "implementation",
      "description": "Implementations connected through compact interface references.",
      "file": "queries/compact_implementations.cypher",
      "parameters": {
        "workflowContractType": {"semanticType": "workflowContract"},
        "activityContractType": {"semanticType": "activityContract"}
      }
    },
    {
      "id": "compact_method_implementations",
      "projections": ["compact"],
      "category": "implementation",
      "description": "Exact method implementations in the compact JVM graph.",
      "file": "queries/compact_method_implementations.cypher",
      "parameters": {
        "workflowContractType": {"semanticType": "workflowContract"},
        "activityContractType": {"semanticType": "activityContract"}
      }
    },
    {
      "id": "compact_resolved_calls",
      "projections": ["compact"],
      "category": "flow",
      "description": "Direct JVM invocation evidence retained by the compact graph.",
      "file": "queries/compact_calls.cypher",
      "parameters": {"sdkOnly": false, "sdkNamespacePrefix": "io.temporal."}
    },
    {
      "id": "compact_temporal_sdk_calls",
      "projections": ["compact"],
      "category": "runtime",
      "description": "Direct calls from first-party code into Temporal APIs.",
      "file": "queries/compact_calls.cypher",
      "parameters": {"sdkOnly": true, "sdkNamespacePrefix": "io.temporal."}
    }
  ]
}
