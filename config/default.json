{
  "schemaVersion": 1,
  "name": "default-index",
  "bazel": {
    "buildModelMode": "prepared",
    "scope": {
      "includeTargetPatterns": ["//..."],
      "includeRuleKinds": [
        "java_binary",
        "java_library",
        "java_test",
        "kt_jvm_binary",
        "kt_jvm_library",
        "kt_jvm_test"
      ],
      "explicitTargets": [],
      "excludeTargetNamePatterns": [
        ".*_deploy_bannedcheck$",
        ".*-sonar$",
        ".*-sq$"
      ],
      "excludeLabels": [],
      "excludeTags": ["coverage", "reporting-only"]
    },
    "preparation": {
      "concurrency": 4,
      "timeoutMs": 600000
    }
  },
  "crawl": {
    "profile": "core",
    "javaSemantics": "batch",
    "concurrency": 4,
    "jdtProcesses": 1,
    "resume": true
  },
  "artifacts": {
    "concurrency": 4,
    "maxClasses": null,
    "fetchSources": true,
    "classpathManifests": []
  },
  "quality": {
    "failOnFailedBuildRoot": true
  },
  "checkpoints": {
    "directory": null
  }
}
